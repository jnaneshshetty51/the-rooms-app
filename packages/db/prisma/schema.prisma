  updatedAt       DateTime         @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([category])
  @@map("lost_and_found")
}

enum LostAndFoundCategory {
  ELECTRONICS
  CLOTHING
  JEWELRY
  DOCUMENTS
  OTHER
}

enum LostAndFoundStatus {
