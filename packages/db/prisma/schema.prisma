  updatedAt       DateTime     @updatedAt

  @@index([bookingId])
  @@index([roomId])
  @@map("damage_assessments")
}

// ─── Phase 1 Schema Additions ──────────────────────────────────────────────────

// ── P0: Critical - Room Maintenance & Staff Management ─────────────────────────

// ── Maintenance Enums ───────────────────────────────────────────────────────────
enum MaintenanceType {
  PLUMBING
  ELECTRICAL
  FURNITURE
  HVAC
  OTHER
}

enum MaintenanceStatus {
  REPORTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ── Staff Management Enums ──────────────────────────────────────────────────────
enum Department {
  FRONT_OFFICE
  HOUSEKEEPING
  MAINTENANCE
  FOOD_BEVERAGE
  ADMIN
}

enum ShiftStatus {
  SCHEDULED
  CHECKED_IN
  CHECKED_OUT
  ABSENT
  ON_LEAVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

// ── Room Maintenance ─────────────────────────────────────────────────────────────
model RoomMaintenance {
  id              String   @id @default(cuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id])
  
  type            MaintenanceType
  priority        Priority         @default(MEDIUM)
  status          MaintenanceStatus @default(REPORTED)
  issue           String
  description     String?
  
  reportedAt      DateTime  @default(now())
  scheduledDate   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  resolution      String?
  resolvedBy      String?
  
  estimatedCost   Decimal?  @db.Decimal(10, 2)
  actualCost      Decimal?  @db.Decimal(10, 2)
  roomStatusOverride RoomStatus?
  
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([roomId, status])
  @@map("room_maintenance")
}

// ── Staff Profile ────────────────────────────────────────────────────────────────
model StaffProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  
  employeeId      String?  @unique
  department      Department @default(FRONT_OFFICE)
  designation     String?
  hireDate        DateTime?
  terminationDate DateTime?
  personalPhone   String?
  emergencyContact String?
  emergencyPhone  String?
  isActive        Boolean  @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shifts          StaffShift[]
  attendances     StaffAttendance[]
  housekeepingStaff HousekeepingStaff?
  activityLogs    StaffActivityLog[]
  
  @@map("staff_profiles")
}

// ── Shift Type ─────────────────────────────────────────────────────────────────
model ShiftType {
  id              String   @id @default(cuid())
  name            String   @unique
  code            String   @unique
  startTime       String
  endTime         String
  durationHours   Int
  gracePeriodMins Int      @default(15)
  isNightShift    Boolean  @default(false)
  defaultFor      Department?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  shifts          StaffShift[]
  
  @@map("shift_types")
}

// ── Staff Shift ─────────────────────────────────────────────────────────────────
model StaffShift {
  id              String   @id @default(cuid())
  staffId         String
  staff           StaffProfile @relation(fields: [staffId], references: [id])
  shiftTypeId     String
  shiftType       ShiftType @relation(fields: [shiftTypeId], references: [id])
  shiftDate       DateTime @db.Date
  checkInTime     DateTime?
  checkOutTime    DateTime?
  status          ShiftStatus @default(SCHEDULED)
  overtimeHours   Decimal?  @db.Decimal(4, 2)
  propertyId      String   @default("default")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([staffId, shiftDate])
  @@map("staff_shifts")
}

// ── Staff Attendance ─────────────────────────────────────────────────────────────
model StaffAttendance {
  id              String   @id @default(cuid())
  staffId         String
  staff           StaffProfile @relation(fields: [staffId], references: [id])
  attendanceDate  DateTime @db.Date
  shiftTypeId     String?
  hoursWorked     Decimal  @db.Decimal(4, 2)
  status          AttendanceStatus
  lateMinutes     Int      @default(0)
  earlyLeaveMinutes Int    @default(0)
  notes           String?
  propertyId      String   @default("default")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([staffId, attendanceDate])
  @@map("staff_attendance")
}

// ── P1: High - Housekeeping Enhancement & Pricing ───────────────────────────────

// ── Housekeeping Staff ──────────────────────────────────────────────────────────
model HousekeepingStaff {
  id              String   @id @default(cuid())
  staffProfileId  String   @unique
  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id])
  specializations String[] @default([])
  avgCleanTimeMins Int     @default(30)
  roomsCleanedToday Int     @default(0)
  roomsCleanedMonth Int     @default(0)
  qualityScore     Decimal? @db.Decimal(3, 2)
  lastEvaluatedAt  DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("housekeeping_staff")
}

// ── Staff Activity Log ──────────────────────────────────────────────────────────
model StaffActivityLog {
  id              String   @id @default(cuid())
  staffId         String
  staffProfile    StaffProfile @relation(fields: [staffId], references: [id])
  
  // Activity details
  action          String   // LOGIN, LOGOUT, TASK_START, TASK_COMPLETE, STATUS_CHANGE, SHIFT_CHECK_IN, SHIFT_CHECK_OUT
  entityType      String?  // "booking" | "room" | "task" | "shift" | "attendance" | "system"
  entityId        String?
  
  // Value tracking
  oldValue        Json?
  newValue        Json?
  
  // Notes
  notes           String?
  
  // Location/IP for security tracking
  ipAddress       String?
  userAgent       String?
  
  propertyId      String   @default("default")
  
  createdAt       DateTime  @default(now())

  @@index([staffId, createdAt])
  @@index([entityType, entityId])
  @@index([propertyId, createdAt])
  @@index([propertyId, action, createdAt])
  @@index([action])
  @@map("staff_activity_logs")
}

// ── Housekeeping Task Template ───────────────────────────────────────────────────
model HousekeepingTaskTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?
  roomType        RoomType?
  condition       RoomCondition?
  frequency       TaskFrequency
  checklistItems  Json
  estimatedMinutes Int     @default(30)
  priority        Int      @default(0)
  isActive        Boolean  @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("housekeeping_task_templates")
}

// ── Room Inspection Enums ────────────────────────────────────────────────────────
enum InspectionType {
  DAILY
  WEEKLY
  MONTHLY
  PRE_CHECKOUT
  POST_CHECKOUT
}

enum InspectionResult {
  PASS
  FAIL
  CONDITIONAL_PASS
}

enum RoomCondition {
  VACANT_CLEAN
  VACANT_DIRTY
  OCCUPIED
  OUT_OF_ORDER
  OUT_OF_SERVICE
}

enum TaskFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  ON_DEMAND
}

// ── Room Inspection ─────────────────────────────────────────────────────────────
model RoomInspection {
  id              String   @id @default(cuid())
  roomId          String
  type            InspectionType
  date            DateTime @db.Date
  inspectorId     String
  checklistResults Json
  overallStatus   InspectionResult
  issues          String?
