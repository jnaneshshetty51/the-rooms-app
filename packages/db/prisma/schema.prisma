// ─── Phase 3: Enhancement Models ─────────────────────────────────────────────

// ── Partner Hotel ─────────────────────────────────────────────────────────────
model PartnerHotel {
  id              String    @id @default(cuid())
  name            String
  address         String?
  city            String?

  // Contact
  phone           String?
  email           String?

  // Room types available
  roomTypes       RoomType[]

  // Pricing
  negotiatedRate  Decimal?  @db.Decimal(10, 2) // Our cost
  guestPays       Decimal?  @db.Decimal(10, 2) // If guest pays difference

