  COMPLETED
  CANCELLED
}

// ── Discount Approval Request ─────────────────────────────────────────────────
// For feature #33 - Discount approval required flow
enum DiscountApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model DiscountApprovalRequest {
  id                       String                  @id @default(cuid())
  bookingId                String
  booking                  Booking                @relation(fields: [bookingId], references: [id])
  
  // Optional discount code reference
  discountCodeId           String?
  discountCode             DiscountCode?          @relation(fields: [discountCodeId], references: [id])
  
  // Discount percentages
  originalDiscountPercent   Decimal?               @db.Decimal(5, 2)
  requestedDiscountPercent  Decimal                @db.Decimal(5, 2)
  
  // Users involved
  requestedById            String
  requestedBy              User                   @relation("DiscountApprovalRequestedBy", fields: [requestedById], references: [id])
  approvedById              String?
  approvedBy                User?                  @relation("DiscountApprovalApprovedBy", fields: [approvedById], references: [id])
  
  // Status and reason
  status                   DiscountApprovalStatus  @default(PENDING)
  reason                   String?
  
  // Timestamps
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([requestedById])
  @@map("discount_approval_requests")
}

// ── Price Override ───────────────────────────────────────────────────────────
// For feature #34 - Manual price override by receptionist
enum PriceOverrideStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

model PriceOverride {
  id               String              @id @default(cuid())
  bookingId        String?
  booking          Booking?           @relation(fields: [bookingId], references: [id])
  
  roomId           String?
  room             Room?              @relation(fields: [roomId], references: [id])
  
  // Price fields
  originalPrice    Decimal             @db.Decimal(10, 2)
  overriddenPrice  Decimal             @db.Decimal(10, 2)
  
  // Reason for override
  reason           String
  
  // Users involved
  requestedById    String
  requestedBy      User                @relation("PriceOverrideRequestedBy", fields: [requestedById], references: [id])
  approvedById     String?
  approvedBy       User?               @relation("PriceOverrideApprovedBy", fields: [approvedById], references: [id])
  
  // Status
  status           PriceOverrideStatus @default(PENDING)
  
  // Validity period
  effectiveFrom    DateTime?
  effectiveUntil   DateTime?
  
  // Timestamps
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([bookingId])
  @@index([roomId])
  @@index([status])
  @@map("price_overrides")
}

// ─── Checkout Features ───────────────────────────────────────────────────────

// ── Checkout Session Status ──────────────────────────────────────────────────
enum CheckoutSessionStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

// ── Checkout Session ──────────────────────────────────────────────────────────
// Tracks express checkout flow for guests
model CheckoutSession {
  id              String                @id @default(cuid())
  bookingId       String                @unique
  booking         Booking              @relation(fields: [bookingId], references: [id])

  // Timing
  initiatedAt     DateTime             @default(now())
  completedAt     DateTime?

  // Status
  status          CheckoutSessionStatus @default(INITIATED)

  // Financial summary
  totalCharges    Decimal?             @db.Decimal(10, 2)
  totalPayments   Decimal?             @db.Decimal(10, 2)
  pendingDues     Decimal?             @db.Decimal(10, 2)

  // Generated invoice reference
  invoiceId       String?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([bookingId])
  @@index([status])
  @@map("checkout_sessions")
}

// ── Damage Type ───────────────────────────────────────────────────────────────
enum DamageType {
  MINOR
  MODERATE
  SEVERE
  TOTAL_LOSS
}

// ── Checkout Type ─────────────────────────────────────────────────────────────
enum CheckoutType {
  STANDARD
  EXPRESS
  LATE
}

// ── Damage Assessment ─────────────────────────────────────────────────────────
// Records damage found during checkout inspection
model DamageAssessment {
  id              String       @id @default(cuid())
  bookingId       String
  booking         Booking      @relation(fields: [bookingId], references: [id])
  roomId          String
  room            Room         @relation(fields: [roomId], references: [id])

  // Damage details
  description     String
  damageType      DamageType

