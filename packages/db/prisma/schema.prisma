  CANCELLED
  MISSED
}

// ── Taxi Booking ──────────────────────────────────────────────────────────────
model TaxiBooking {
  id              String          @id @default(cuid())
  bookingId       String?
  booking         Booking?        @relation(fields: [bookingId], references: [id])
  
  // Guest info
