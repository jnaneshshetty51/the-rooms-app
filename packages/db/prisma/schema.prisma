// ─── Phase 6: Exception Handling ─────────────────────────────────────────────────

// ── Dispute (Scenario 70: Guest dispute on bill) ─────────────────────────────────
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  PENDING_APPROVAL
  RESOLVED
  REJECTED
}

enum DisputeResolutionType {
  FULL_REFUND
  PARTIAL_REFUND
  ADJUSTMENT
  NO_ADJUSTMENT
  WAIVED
}

model Dispute {
  id              String    @id @default(cuid())
  bookingId       String
  booking         Booking   @relation(fields: [bookingId], references: [id])
  guestId         String
  guest           Guest     @relation(fields: [guestId], references: [id])

  // Dispute details
  reason          String
  disputedItems   Json      // Array of { item: string, amount: number, expectedAmount: number }
  expectedAmount  Decimal   @db.Decimal(10, 2)
  disputedAmount  Decimal   @db.Decimal(10, 2)

  // Status
  status          DisputeStatus @default(OPEN)

  // Resolution
  resolution     String?
  adjustmentAmount Decimal?  @db.Decimal(10, 2)
  resolutionType  DisputeResolutionType?

  // Attachments (urls to images/documents)
  attachments     String[]  @default([])

  // Staff response trail
  responses       DisputeResponse[]

  // Property
  propertyId      String    @default("default")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([bookingId])
  @@index([guestId])
  @@index([status])
  @@index([propertyId, status])
  @@map("disputes")
}

model DisputeResponse {
  id          String    @id @default(cuid())
  disputeId   String
  dispute     Dispute   @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  response    String
  attachments String[]  @default([])

  respondedById String?
  createdAt   DateTime  @default(now())

  @@map("dispute_responses")
}

// ── Fraud Flag (Scenario 71: Fraudulent booking detection) ───────────────────────
enum FraudStatus {
  PENDING_REVIEW
  UNDER_INVESTIGATION
  CONFIRMED_FRAUD
  FALSE_POSITIVE
  ACTION_TAKEN
}

model FraudFlag {
  id              String    @id @default(cuid())
  bookingId       String
  booking         Booking   @relation(fields: [bookingId], references: [id])

  // Flag details
  reason          String
  riskScore       Int       // 0-100
  riskFactors     Json      // Array of { factor: string, score: number, description: string }

  // Status
  status          FraudStatus @default(PENDING_REVIEW)

  // Investigation
  investigationNotes String?
  actionTaken     String?
  dismissedReason String?

  // Property
  propertyId      String    @default("default")

  // Timestamps
  flaggedAt       DateTime  @default(now())
  resolvedAt      DateTime?

  createdById     String?

  @@index([bookingId])
  @@index([status])
  @@index([propertyId, status])
  @@map("fraud_flags")
}

// ── Room Conflict (Scenario 72: Double room allocation conflict) ──────────────────
enum ConflictResolution {
  MOVE_GUEST
  UPGRADE
  DOWNGRADE
  CANCEL
  RELOCATE
}

model RoomConflict {
  id              String    @id @default(cuid())
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id])

  // Conflict dates
  conflictDate    DateTime  @db.Date

  // Conflicting bookings
  bookingId1      String
  booking1        Booking   @relation("ConflictBooking1", fields: [bookingId1], references: [id])
  bookingId2      String
  booking2        Booking   @relation("ConflictBooking2", fields: [bookingId2], references: [id])

  // Resolution
  resolution      ConflictResolution?
  resolvedAt      DateTime?
  resolvedById    String?
  notes           String?

  // Alternative room if resolved by moving
  alternativeRoomId String?

  // Property
  propertyId      String    @default("default")

  createdAt       DateTime  @default(now())

  @@index([roomId, conflictDate])
  @@index([propertyId])
  @@map("room_conflicts")
}

// ── Offline Entry (Scenario 73: System offline → manual entry → later sync) ─────
enum OfflineSyncStatus {
  PENDING
  SYNCING
  SYNCED
  CONFLICT
  FAILED
}

model OfflineEntry {
  id              String    @id @default(cuid())
  localId         String    // Client-generated ID for deduplication
  bookingId       String?   // Created booking after sync

  // Entry data snapshot
  entryType       String    // "BOOKING" | "PAYMENT" | "GUEST"
  entryData       Json      // Full copy of what was submitted

  // Sync tracking
  syncStatus      OfflineSyncStatus @default(PENDING)
  clientTimestamp DateTime  // When it was created on client
  syncedAt        DateTime?
  syncError       String?

  // Conflict info
  conflictInfo    Json?     // Details about any sync conflicts
  resolvedAt      DateTime?

  // Property
  propertyId      String    @default("default")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([localId, propertyId])
  @@index([propertyId, syncStatus])
  @@map("offline_entries")
}

// ── Lost Booking (Scenario 74: Lost booking recovery) ───────────────────────────
enum RecoveryAction {
  REACTIVATED
  REFUNDED
  REBOOKED
  MERGED
  CANCELLED
}

model LostBooking {
  id              String    @id @default(cuid())
  bookingId       String    @unique
  booking         Booking   @relation(fields: [bookingId], references: [id])

  // Loss details
  reason          String    // "GUEST_NOT_FOUND" | "PAYMENT_NOT_FOUND" | "BOOKING_MISFILED" | "SYSTEM_ERROR" | "OTHER"
  description     String?

  // Recovery
  recoveryAction  RecoveryAction?
  recoveredAt     DateTime?
  recoveredById    String?

  // Linking to found booking
  linkedBookingId String?

  // Property
  propertyId      String    @default("default")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([bookingId])
  @@index([propertyId])
  @@map("lost_bookings")
}
